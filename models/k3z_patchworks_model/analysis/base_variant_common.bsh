/*
 * Shared Patchworks PIN body for baseline-derived K3Z variants.
 * Wrapper pins must define `tracks_path_prefix` before sourcing this file.
 */

/*************************************************************
 *
 * Set global variables in this section
 *
 *************************************************************/

/*
 * Set the number of planning periods and period width
 */
int periods = 30;
Horizon.setHorizon(periods, 10);

/*
 * These variables can turn patch and route accounts off or on
 */
boolean useRoutes = false;
boolean usePatches = false;

sourceRelative("../scripts/targets/flowTargets.bsh");
sourceRelative("../scripts/targets/seralStages.bsh");

/*
 * Locate the input matrix data files
 */
blocks = tracks_path_prefix + "blocks.csv";
curves = tracks_path_prefix + "curves.csv";
features = tracks_path_prefix + "features.csv";
products = tracks_path_prefix + "products.csv";
tracknames = tracks_path_prefix + "tracknames.csv";
treatments = tracks_path_prefix + "treatments.csv";
accounts = tracks_path_prefix + "accounts.csv";
stratas = tracks_path_prefix + "strata.csv";
if (
    AttributeStore.absoluteFile(tracks_path_prefix + "packages.csv").exists()
    && AttributeStore.absoluteFile(tracks_path_prefix + "packageSequences.csv").exists()
) {
  packages = tracks_path_prefix + "packages.csv";
  sequences = tracks_path_prefix + "packageSequences.csv";
}

/*
 * Locate the shape file that contains candidate harvest block boundaries.
 */
block_shape = "../blocks/blocks.shp";
block_key = "BLOCK";

/*
 * Locate road network files (if required).
 */
String roads_path_prefix = "../roads/";
roadShapeFile = roads_path_prefix + "access.shp";
roadShapeKey = "ACCESS_";
if (useRoutes) {
   vertices = roads_path_prefix + "vertices.csv";
   segments = roads_path_prefix + "segments.csv";
   destinations = roads_path_prefix + "destinations.csv";
   linkages = roads_path_prefix + "linkages.csv";
}

int Patchworks_TargetInit() {
   /*
    * This function is called when Patchworks is setting up
    * account and target structures.
    */

   /*
    * Load groups here
   */
   control.calculateGroups("AU");
   control.calculateGroups("IFM");
   control.inputGroups("../tracks_overlay_basecase_sum/groups.csv");

   setupYieldFlowTargets(control, periods, tracks_path_prefix);
   validateSeralStageAttributes();

   /*
    * Summary accounts here
    */

   /*
    * Load topology file here
    */
   control.inputTopology("../blocks/topology_blocks_200r.csv", 100d);

   /*
    * Load patch target definitions here
    */
    if (usePatches) {
    }

   /*
    * Load road target definitions here
    */
    if (useRoutes) {
    }

   /*
    * Ratio accounts here
    */

   /*
    * Return 1 to signal that everything is ok.
    */
    return 1;
}

int PatchWorks_Init() {
   /*
    * This function is called when Patchworks is setting up
    * the graphical user interface.  You can add statements.
    * to this function to define reports and customize the.
    * Map Viewer.
    */

   /*
    * Load the default user interface
    */
   classic_GUI(control);

   /*
    * Set up the initial harvest targets
    * Uncomment and edit these lines if required
    */
   // control.loadTargetSummary("initialTargetSummary.csv");
   // control.loadTargetStatus("initialTargetStatus.csv");

   /*
    * Establish the initial timing constraints
    * Uncomment and edit these lines if required
    */
   // control.getAccessTable().setKey("COMPART");
   // control.getAccessTable().load("access.csv");
   // control.getAccessTable().apply();

   /*
    * Add Map layer definitions here.  The first layer
    * added will appear on the bottom of the legend.
    */

   /*
    * This is a single coloured theme that show the blocks
    */
    DefaultTheme def = new DefaultTheme(blockData, new PolygonSymbol(new Color(204, 204, 255)));
    Layer defLayer = new GeoRelLayer(blockData, def);
    layers.add(defLayer);
	
   /*
    * This map layer shows the harvest treatments in the current period
    */
    UniqueValueTheme currTreatTheme = new UniqueValueTheme(blockData);
    currTreatTheme.setFieldname("CURRENTTREATMENT");
    currTreatTheme.addElement(new ThemeElement("CC",
        PolygonSymbol.getDefault(Symbol.FILL, Symbol.GEMS, 0)),
        "CC");
    currTreatTheme.setCaption("Current Treatments");
    currTreatTheme.setUnclassified(new ThemeElement("", PolygonSymbol.erase));
    blockData.addTheme(currTreatTheme);
    GeoRelLayer currTreatLayer = new GeoRelLayer(blockData, currTreatTheme);
    currTreatLayer.setVisible(false);
    layers.add(currTreatLayer);

   /*
    * This map layer shows the all harvest treatments applied up until the current period
    */
    UniqueValueTheme latestTreatTheme = new UniqueValueTheme(blockData);
    latestTreatTheme.setFieldname("LASTTREATMENT");
    latestTreatTheme.addElement(new ThemeElement("CC",
        PolygonSymbol.getDefault(Symbol.FILL, Symbol.GEMS, 0)),
        "CC");
    latestTreatTheme.setCaption("Latest Treatments");
    latestTreatTheme.setUnclassified(new ThemeElement("", PolygonSymbol.erase));
    blockData.addTheme(latestTreatTheme);
    GeoRelLayer latestTreatLayer = new GeoRelLayer(blockData, latestTreatTheme);
    latestTreatLayer.setVisible(false);
    layers.add(latestTreatLayer);
   /*
    * Create a dithered theme based on seral stage.
    */
    AlphaComposite alpha = AlphaComposite.SrcOver;
    global.seral2 = new DitherTheme(blockData, "feature.Seral.");
    seral2.setCaption("Dithered Seral Stage");
    seral2.setAlpha(alpha);
    seral2.setIsScaled(false);
    seral2.addElement("Regen", new Color (250, 230, 0), "feature.Seral.regenerating");
    seral2.addElement("Young", new Color (200, 250, 200), "feature.Seral.young");
    seral2.addElement("Immature", new Color (160, 220, 160), "feature.Seral.immature");
    seral2.addElement("Mature", new Color (100, 190, 100), "feature.Seral.mature");
    seral2.addElement("Old", new Color (128, 64, 64), "feature.Seral.overmature");
    blockData.addTheme(seral2, "Dithered Seral Stage");
    Layer seral2Layer = new GeoRelLayer(blockData, seral2);
    seral2Layer.setTitle("Seral Stages");
    layers.add(seral2Layer);
	
/**
 * These commands will set up the map viewer with the following layers:
 * - Rec Areas
 * - Seral Stages
 * - Latest Treatments
 * - Current Treatments
 * - Block attributes
 * - Seral Stages
 * - Latest Treatments
 * - Current Treatments
 * - Block attributes
 *
 * Copy this map layer definition code into the console or script file.
 * You might need to rename some of the variables in case
 * the same names have already been used.
 */

theme1 = new DefaultTheme(new PolygonSymbol(new Color(204, 204, 255)) // symbol
);
theme1.setCaption("Block attributes");
layer0 = new GeoRelLayer(control.getBlockTable(), // table
    theme1, // theme
    "" // fieldname
);
theme3 = new UniqueValueTheme();
theme3.setCaption("Current Treatments");
theme3.setUnclassified(new ThemeElement("", new PolygonSymbol(Color.white, new LineSymbol(new SimpleLineSymbol(null, 1.0))).setVisibility(0.0, 1.7976931348623157E308, AlphaComposite.Clear)));
theme3.setUseUnclassified(true);
theme3.addElement(new ThemeElement("CC", new PolygonSymbol(new Color(243, 137, 139))), "CC");
layer2 = new GeoRelLayer(control.getBlockTable(), // table
    theme3, // theme
    "CURRENTTREATMENT" // fieldname
);
layer2.setVisible(false);
theme5 = new UniqueValueTheme();
theme5.setCaption("Latest Treatments");
theme5.setUnclassified(new ThemeElement("", new PolygonSymbol(Color.white, new LineSymbol(new SimpleLineSymbol(null, 1.0))).setVisibility(0.0, 1.7976931348623157E308, AlphaComposite.Clear)));
theme5.setUseUnclassified(true);
theme5.addElement(new ThemeElement("CC", new PolygonSymbol(new Color(243, 137, 139))), "CC");
layer4 = new GeoRelLayer(control.getBlockTable(), // table
    theme5, // theme
    "LASTTREATMENT" // fieldname
);
layer4.setVisible(false);
theme7 = new DitherTheme();
theme7.setCaption("Dithered Seral Stage");
theme7.addElement("Regen", new Color(250, 230, 0), "feature.Seral.regenerating");
theme7.addElement("Young", new Color(200, 250, 200), "feature.Seral.young");
theme7.addElement("Immature", new Color(160, 220, 160), "feature.Seral.immature");
theme7.addElement("Mature", new Color(100, 190, 100), "feature.Seral.mature");
theme7.addElement("Old", new Color(128, 64, 64), "feature.Seral.overmature");
layer6 = new GeoRelLayer(control.getBlockTable(), // table
    theme7, // theme
    "feature.Seral." // fieldname
);
layer6.setTitle("Seral Stages");
theme9 = new DefaultTheme(new PolygonSymbol(new Color(204, 204, 255)) // symbol
);
theme9.setCaption("Block attributes");
theme9.setAlpha(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, 0.37f));
layer8 = new GeoRelLayer(control.getBlockTable(), // table
    theme9, // theme
    "" // fieldname
);
theme11 = new UniqueValueTheme();
theme11.setCaption("Current Treatments");
theme11.setUnclassified(new ThemeElement("", new PolygonSymbol(Color.white, new LineSymbol(null, 1.0)).setVisibility(0.0, 1.7976931348623157E308, AlphaComposite.Clear)));
theme11.setUseUnclassified(true);
theme11.addElement(new ThemeElement("CC", new PolygonSymbol(new Color(243, 137, 139))), "CC");
layer10 = new GeoRelLayer(control.getBlockTable(), // table
    theme11, // theme
    "CURRENTTREATMENT" // fieldname
);
layer10.setVisible(false);
theme13 = new UniqueValueTheme();
theme13.setCaption("Latest Treatments");
theme13.setUnclassified(new ThemeElement("", new PolygonSymbol(Color.white, new LineSymbol(null, 1.0)).setVisibility(0.0, 1.7976931348623157E308, AlphaComposite.Clear)));
theme13.setUseUnclassified(true);
theme13.addElement(new ThemeElement("CC", new PolygonSymbol(new Color(243, 137, 139))), "CC");
layer12 = new GeoRelLayer(control.getBlockTable(), // table
    theme13, // theme
    "LASTTREATMENT" // fieldname
);
layer12.setVisible(false);
theme15 = new DitherTheme();
theme15.setCaption("Dithered Seral Stage");
theme15.addElement("Regen", new Color(250, 230, 0), "feature.Seral.regenerating");
theme15.addElement("Young", new Color(200, 250, 200), "feature.Seral.young");
theme15.addElement("Immature", new Color(160, 220, 160), "feature.Seral.immature");
theme15.addElement("Mature", new Color(100, 190, 100), "feature.Seral.mature");
theme15.addElement("Old", new Color(128, 64, 64), "feature.Seral.overmature");
layer14 = new GeoRelLayer(control.getBlockTable(), // table
    theme15, // theme
    "feature.Seral." // fieldname
);
layer14.setTitle("Seral Stages");
layer14.setVisible(false);
theme17 = new UniqueValueTheme();
theme17.setCaption("group ");
theme17.addElement(new ThemeElement("", new PolygonSymbol(null)), "");
theme17.addElement(new ThemeElement("Bike1", new PolygonSymbol(new Color(255, 204, 230))), "Bike1");
theme17.addElement(new ThemeElement("Bike2", new PolygonSymbol(new Color(255, 128, 191))), "Bike2");
theme17.addElement(new ThemeElement("Bike3", new PolygonSymbol(new Color(255, 0, 128))), "Bike3");
theme17.addElement(new ThemeElement("Camp1", new PolygonSymbol(new Color(204, 230, 255))), "Camp1");
theme17.addElement(new ThemeElement("Camp2", new PolygonSymbol(new Color(128, 191, 255))), "Camp2");
theme17.addElement(new ThemeElement("Camp3", new PolygonSymbol(new Color(0, 128, 255))), "Camp3");
theme17.addElement(new ThemeElement("ECO1", new PolygonSymbol(new Color(204, 255, 204))), "ECO1");
theme17.addElement(new ThemeElement("ECO2", new PolygonSymbol(new Color(128, 255, 128))), "ECO2");
theme17.addElement(new ThemeElement("ECO3", new PolygonSymbol(Color.green)), "ECO3");
theme17.addElement(new ThemeElement("Hike1", new PolygonSymbol(new Color(255, 230, 204))), "Hike1");
theme17.addElement(new ThemeElement("Hike2", new PolygonSymbol(new Color(255, 191, 128))), "Hike2");
theme17.addElement(new ThemeElement("Hike3", new PolygonSymbol(new Color(255, 128, 0))), "Hike3");
layer16 = new GeoRelLayer(control.getBlockTable(), // table
    theme17, // theme
    "group " // fieldname
);
layer16.setTitle("Rec Areas");
layers.add(layer0);
layers.add(layer2);
layers.add(layer4);
layers.add(layer6);
layers.add(layer8);
layers.add(layer10);
layers.add(layer12);
layers.add(layer14);
layers.add(layer16);


   /*
    * Put patch maps here.
    */
    if (usePatches) {
    }

   /*
    * Put route maps here.
    */
    if (useRoutes) {
    }

   /*
    * Add ReportWriter definitions here
    */

    RangeLabel[] ageClass = new RangeLabel[] {
      new RangeLabel("Regen", -5, 0),
      new RangeLabel("1 - 20", 0, 20),
      new RangeLabel("20 - 40", 20, 40),
      new RangeLabel("40 - 60", 40, 60),
      new RangeLabel("60 - 80", 60, 80),
      new RangeLabel("80 - 100", 80, 100),
      new RangeLabel("100 - 120", 100, 120),
      new RangeLabel("120 - 140", 120, 140),
      new RangeLabel("140+", 140, 9999)
    };

    reportWriter.addReport(new RangePeriodReport(
         "ageClass",
         "Managed area by age class and period",
         "hectares",
         control.getBlockTable(),
         "MANAGEDAREA",
         "MANAGEDOFFSET",
         ageClass,
         null,
         Horizon.periodList,
         null,
         false
    ));

   /*
    * Put route reports here.
    */
    if (useRoutes) {
    }

   /*
    * Put patch reports here.
    */
    if (usePatches) {
    }

   /*
    * Put comparison reports here.
    */

   /*
    * Return 1 to signal that everything is ok.
    */
    return 1;
}
/* END */
